# ---- HuhQueue configuration. Copy to .env and fill in. NEVER commit .env ----

# Where the app keeps its SQLite DB and uploaded media
HUHQ_DATA_DIR=./data

# Local UI + REST API (keep it on localhost)
HUHQ_HOST=127.0.0.1
HUHQ_PORT=8787

# Public "edge" server: serves ONLY media files (random unguessable URLs) and OAuth callbacks.
# This is the only port you expose through a tunnel.
HUHQ_PUBLIC_PORT=8788
# The public https URL that points at HUHQ_PUBLIC_PORT (cloudflared/ngrok URL, or your own domain).
# Leave empty and click "Start tunnel" in Settings to get a free cloudflared quick-tunnel URL automatically.
HUHQ_PUBLIC_BASE_URL=

# Used to encrypt OAuth tokens at rest. Generate with:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
HUHQ_SECRET_KEY=

# App login. The UI always requires a login. Set a password here, or leave empty and create one on first run.
HUHQ_ADMIN_PASSWORD=
# Bearer token for the CLI / your pipeline (Authorization: Bearer <token>). You can also mint tokens in Settings -> API.
HUHQ_API_TOKEN=
# Set to 1 if you serve the UI over https
HUHQ_COOKIE_SECURE=0

# Default timezone for posting slots
HUHQ_TIMEZONE=Europe/Dublin

# Optional: POST a JSON payload here for "Notify me" posts and failures (e.g. an ntfy.sh topic, Slack/Discord webhook)
HUHQ_NOTIFY_WEBHOOK_URL=

# Worker
HUHQ_WORKER_INTERVAL_SECONDS=15
# Tries per post before it is marked failed (retries wait 60 s doubling to 1 h, with jitter; a network's Retry-After wins).
# Rate-limit waits don't count. Scheduled posts missed by more than 6 h (app down/asleep) are re-queued or flagged.
HUHQ_MAX_ATTEMPTS=6

# ---- Instagram (Instagram API with Instagram Login) ----
# Meta app dashboard -> Instagram -> API setup with Instagram login -> "Instagram app ID" / "Instagram app secret"
INSTAGRAM_APP_ID=
INSTAGRAM_APP_SECRET=
# Graph API version used for graph.instagram.com
INSTAGRAM_GRAPH_VERSION=v26.0
# Scopes requested at connect time (comments/insights are optional extras)
INSTAGRAM_SCOPES=instagram_business_basic,instagram_business_content_publish,instagram_business_manage_comments,instagram_business_manage_insights

# ---- TikTok (Login Kit + Content Posting API) ----
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=
TIKTOK_SCOPES=user.info.basic,user.info.profile,user.info.stats,video.publish,video.upload,video.list
# Set to 1 only after TikTok has audited your app (until then direct posts are forced to SELF_ONLY / private)
TIKTOK_AUDITED=0

# ---- YouTube (Google OAuth + YouTube Data API v3) ----
YOUTUBE_CLIENT_ID=
YOUTUBE_CLIENT_SECRET=
# Set to 1 after Google verified/audited your API project (until then uploads are forced private)
YOUTUBE_VERIFIED=0

# ---- X / Twitter (OAuth 2.0 with PKCE + X API v2) ----
# developer.x.com -> your app -> Keys and tokens -> OAuth 2.0 Client ID / Client Secret
X_CLIENT_ID=
X_CLIENT_SECRET=
X_SCOPES=tweet.read tweet.write users.read media.write offline.access

# ---- LinkedIn (personal profile: "Sign In with LinkedIn using OpenID Connect" + "Share on LinkedIn") ----
# developer.linkedin.com -> your app -> Auth -> Client ID / Client Secret; redirect URL <public url>/oauth/linkedin/callback
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
LINKEDIN_SCOPES=openid profile email w_member_social
# LinkedIn-Version header (YYYYMM). LinkedIn retires old versions, so bump this when they announce a sunset.
LINKEDIN_API_VERSION=202605
# Company pages: a SECOND app with only the Community Management API product (LinkedIn approves it for companies).
# Redirect URL <public url>/oauth/linkedin_page/callback
LINKEDIN_PAGES_ENABLED=0
LINKEDIN_PAGES_CLIENT_ID=
LINKEDIN_PAGES_CLIENT_SECRET=
LINKEDIN_PAGES_SCOPES=r_organization_social w_organization_social rw_organization_admin

# App keys can also be pasted in the web UI (Settings -> App keys); a key saved there wins over this file.

# Hosted installs: where the browser UI lives if it is not on localhost (used by the separate edge port's
# OAuth redirect). Not needed when the UI itself is the public URL (it answers /oauth/... too).
HUHQ_UI_BASE_URL=

# Demo / tests only: adds a fake "Demo" connector that never touches a real network
HUHQ_ENABLE_FAKE=0

# Optional: email team invites and notifications (approvals, comments, @mentions). Invite links work without it.
# HUHQ_SMTP_HOST=smtp.example.com
# HUHQ_SMTP_PORT=587
# HUHQ_SMTP_USER=you@example.com
# HUHQ_SMTP_PASSWORD=app-password
# HUHQ_SMTP_FROM=HuhQueue <you@example.com>
# HUHQ_SMTP_TLS=starttls   # starttls | ssl | none

# ---- HuhQueue (Buffer Commit edition, studio/) ----
# Create a private app client at https://publish.buffer.com/settings/api (redirect URI = PUBLIC_URL + /callback)
BUFFER_CLIENT_ID=
BUFFER_CLIENT_SECRET=
PUBLIC_URL=https://localhost:8000
SESSION_SECRET=            # openssl rand -hex 32
TOKEN_KEY=                 # seals Buffer tokens and AI keys at rest, separate from SESSION_SECRET:
# TOKEN_KEY value: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
TOKEN_KEY_PREVIOUS=        # during a rotation: the old TOKEN_KEY (comma list); rows are re-sealed on boot, then remove it
DATABASE_URL=              # postgres://... in production; empty = local SQLite (studio.db). Supabase: use the Session pooler URL
MIGRATE_FROM_URL=          # optional, one deploy only: old DATABASE_URL; rows are copied into the empty new database on boot
# Optional OpenAI-compatible model for caption drafting (empty = built-in drafter)
AI_BASE_URL=
AI_API_KEY=
AI_MODEL=
