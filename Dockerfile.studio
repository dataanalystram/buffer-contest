# HuhQueue (Buffer Commit edition): one small web process.
# Render/any host: set BUFFER_CLIENT_ID, BUFFER_CLIENT_SECRET, SESSION_SECRET, PUBLIC_URL, DATABASE_URL (Postgres).
FROM python:3.12-slim
WORKDIR /app
COPY requirements-studio.txt ./
RUN pip install --no-cache-dir -r requirements-studio.txt && useradd --create-home --uid 1000 app
COPY studio ./studio
# MCP resources huhqueue://docs/MCP_TOOLS.md and huhqueue://docs/DESIGN.md (studio/mcp_prompts.py)
COPY DESIGN.md ./DESIGN.md
COPY docs/MCP_TOOLS.md ./docs/MCP_TOOLS.md
USER app
ENV PYTHONUNBUFFERED=1 PORT=10000
EXPOSE 10000
CMD ["sh", "-c", "uvicorn studio.app:create_app --factory --host 0.0.0.0 --port ${PORT} --proxy-headers --forwarded-allow-ips '*'"]
